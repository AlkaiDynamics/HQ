{
  "schema_version": "0.1.1",
  "purpose": "Evidence-backed reverse-engineering graph for the frozen Neurite specimens and their native migration.",
  "node_types": {
    "Repository": ["id", "name", "url"],
    "Specimen": ["id", "repository_id", "branch", "commit", "tree", "role"],
    "SourceArtifact": ["id", "specimen_id", "path", "blob_sha", "size"],
    "Subsystem": ["id", "name", "legacy_or_target"],
    "Symbol": ["id", "name", "symbol_kind", "artifact_id"],
    "Interaction": ["id", "name"],
    "Behavior": ["id", "name", "source_status", "runtime_status", "golden_status"],
    "Command": ["id", "name", "consequence_class"],
    "State": ["id", "name", "state_domain", "durability", "authority", "regenerability"],
    "Projection": ["id", "name", "projection_kind"],
    "EntityKind": ["id", "name"],
    "RelationshipKind": ["id", "name"],
    "ExternalEffect": ["id", "name", "reversibility", "auditability"],
    "Service": ["id", "name", "service_kind"],
    "API": ["id", "name", "endpoint_or_family"],
    "Capability": ["id", "name", "risk_class"],
    "Contract": ["id", "name", "status", "treatment"],
    "RuntimeBindingKind": ["id", "name"],
    "Fixture": ["id", "name", "status"],
    "Evidence": ["id", "evidence_type", "confidence", "observation"],
    "Assertion": ["id", "statement", "status"],
    "FailureMode": ["id", "name", "status"],
    "RustSubsystem": ["id", "name"]
  },
  "edge_types": {
    "CONTAINS": {"from": ["Repository", "Specimen", "Subsystem"], "to": ["Specimen", "SourceArtifact", "Symbol", "Subsystem"]},
    "DECLARES": {"from": ["SourceArtifact"], "to": ["Symbol"]},
    "CALLS": {"from": ["Symbol", "Behavior"], "to": ["Symbol", "API", "Service"]},
    "ENTERS": {"from": ["Interaction"], "to": ["Behavior", "Symbol"]},
    "IMPLEMENTS": {"from": ["Symbol", "Subsystem"], "to": ["Behavior", "Contract"]},
    "READS": {"from": ["Behavior", "Symbol", "Service"], "to": ["State"]},
    "WRITES": {"from": ["Behavior", "Symbol", "Service"], "to": ["State"]},
    "PERSISTS_TO": {"from": ["State", "Behavior"], "to": ["State", "Service"]},
    "LOADS_FROM": {"from": ["Behavior"], "to": ["State"]},
    "TRIGGERS": {"from": ["Interaction", "Behavior", "Command"], "to": ["Behavior", "ExternalEffect"]},
    "RENDERS": {"from": ["Behavior", "EntityKind"], "to": ["Projection"]},
    "DEPENDS_ON": {"from": ["Behavior", "Subsystem", "Projection", "Service"], "to": ["Service", "API", "Capability", "RuntimeBindingKind", "Subsystem"]},
    "REQUIRES": {"from": ["Behavior", "ExternalEffect", "Projection", "Command"], "to": ["Capability"]},
    "HAS_AUTHORITY": {"from": ["Service", "RuntimeBindingKind"], "to": ["Capability"]},
    "PRODUCES_EFFECT": {"from": ["Behavior", "Service", "Command"], "to": ["ExternalEffect"]},
    "HAS_PROJECTION": {"from": ["EntityKind"], "to": ["Projection"]},
    "USES_RELATIONSHIP": {"from": ["Behavior", "Contract"], "to": ["RelationshipKind"]},
    "MAPS_TO_CONTRACT": {"from": ["Behavior", "Subsystem", "EntityKind", "Projection", "Command"], "to": ["Contract"]},
    "TARGETS_SUBSYSTEM": {"from": ["Contract"], "to": ["RustSubsystem"]},
    "EVIDENCED_BY": {"from": ["Behavior", "State", "ExternalEffect", "Contract", "Assertion", "Command"], "to": ["Evidence"]},
    "EVIDENCE_SOURCE": {"from": ["Evidence"], "to": ["SourceArtifact", "Fixture", "Specimen"]},
    "SUPPORTS": {"from": ["Evidence"], "to": ["Assertion"]},
    "VERIFIED_BY": {"from": ["Behavior", "Contract", "Assertion"], "to": ["Fixture"]},
    "HAS_FAILURE_MODE": {"from": ["Behavior", "Service", "Projection"], "to": ["FailureMode"]},
    "RUNS_ON": {"from": ["Behavior", "Projection", "Service", "Command"], "to": ["RuntimeBindingKind"]},
    "SUPERSEDES": {"from": ["Contract", "RustSubsystem"], "to": ["Behavior", "Subsystem"]}
  },
  "evidence_types": [
    "SOURCE-DERIVED",
    "RUNTIME-OBSERVED",
    "GOLDEN-DIFFERENTIAL",
    "INFERRED",
    "HYPOTHESIZED",
    "CONTRADICTED"
  ],
  "statuses": [
    "OPEN",
    "SOURCE-CLOSED",
    "RUNTIME-VERIFIED",
    "GOLDEN-VERIFIED",
    "RUST-IMPLEMENTED",
    "DIFFERENTIAL-PASS",
    "PROMOTED"
  ],
  "treatments": ["K", "R", "S", "B", "X"],
  "provenance_required_for_asserted_edges": [
    "specimen_id",
    "commit",
    "source_path_or_fixture",
    "evidence_type",
    "confidence"
  ],
  "rules": [
    "A visualization is never an authoritative source; it is generated from graph data.",
    "SOURCE-DERIVED does not imply RUNTIME-VERIFIED.",
    "No behavior may be marked PROMOTED without differential evidence where applicable.",
    "VisualEdge, SemanticReference, AuthorityRelation and RuntimeRelation are distinct relationship kinds.",
    "A persisted path, provider choice, code snippet or projection does not imply a capability grant.",
    "Neurite local state and ARGO authoritative state remain distinct domains."
  ]
}
